<?xml version="1.0"?>
<extension key="au.com.agileware.renewalinvoices" type="module">
  <file>renewalinvoices</file>
  <name>Renewal Invoices for Memberships</name>
  <description>This extension adds extra features to Membership Scheduled Reminders allowing mails to be sent to related contacts of members.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Agileware</author>
    <email>support@agileware.com.au</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://agileware.com.au</url>
    <url desc="Documentation">https://agileware.com.au</url>
    <url desc="Support">https://support.agileware.com.au</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
    <url desc="Documentation">https://github.com/agileware/au.com.agileware.renewalinvoices/blob/master/README.md</url>
  </urls>
  <releaseDate>2026-09-12</releaseDate>
  <version>2.1.2</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>5.51</ver>
  </compatibility>
  <civix>
    <namespace>CRM/RenewalInvoices</namespace>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>smarty-v2@1.0.3</mixin>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <upgrader>CiviMix\Schema\Renewalinvoices\AutomaticUpgrader</upgrader>
</extension>
